<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">yalla.games</domain>
        <domain includeSubdomains="true">yallaludo.com</domain>
        <domain includeSubdomains="true">shuzilm.cn</domain>
        <domain includeSubdomains="true">telecome.cn</domain>
        <trust-anchors>
            <certificates src="@raw/cacert" />
        </trust-anchors>
        <domain-config cleartextTrafficPermitted="false">
            <domain includeSubdomains="false">ludocc.com</domain>
        </domain-config>
    </domain-config>
</network-security-config>