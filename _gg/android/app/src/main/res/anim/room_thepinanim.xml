<?xml version="1.0" encoding="utf-8"?>
<set android:interpolator="@android:anim/decelerate_interpolator" android:shareInterpolator="true"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <alpha android:duration="150" android:fromAlpha="0.3" android:toAlpha="1.0" />
    <scale android:duration="200" android:pivotX="50.0%" android:pivotY="50.0%" android:fromXScale="6.0" android:toXScale="0.9" android:fromYScale="6.0" android:toYScale="0.9" />
    <set android:startOffset="200">
        <scale android:duration="150" android:pivotX="50.0%" android:pivotY="50.0%" android:fromXScale="0.9" android:toXScale="1.2" android:fromYScale="0.9" android:toYScale="1.2" />
    </set>
    <set android:startOffset="350">
        <scale android:duration="150" android:pivotX="50.0%" android:pivotY="50.0%" android:fromXScale="1.2" android:toXScale="1.0" android:fromYScale="1.2" android:toYScale="1.0" />
    </set>
</set>