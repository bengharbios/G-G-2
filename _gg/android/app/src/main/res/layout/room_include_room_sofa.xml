<?xml version="1.0" encoding="utf-8"?>
<!--
  room_include_room_sofa.xml — الأريكة (Sofa) - حاوية المستمعين (مطابق لـ Yalla Ludo)
  ارتفاع 51dp، تظهر في أسفل منطقة المقاعد
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sofa_container"
    android:layout_width="match_parent"
    android:layout_height="51dp">

    <!-- عداد المستمعين على اليسار -->
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="start|center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_sofa_count"
        android:background="@drawable/sofa_count_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_room_top_sound" />

        <com.bengharbios.ggames.view.CustomTextView
            android:textSize="11dp"
            android:textColor="#FFFFFF"
            android:id="@+id/tv_sofa_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:text="0 مستمع" />
    </LinearLayout>

    <!-- قائمة المستمعين الأفقي -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_sofa_listeners"
        android:layout_gravity="end|center_vertical"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginEnd="40dp" />

</FrameLayout>
