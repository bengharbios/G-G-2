<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_bg"
    android:padding="20dp"
    android:gravity="center_horizontal">

    <com.bengharbios.ggames.view.CustomTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:text="الرقم الحظ" />

    <!-- العرض الرئيسي -->
    <FrameLayout
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="16dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/badge_red"
            android:scaleType="fitCenter" />

        <com.bengharbios.ggames.view.CustomTextView
            android:id="@+id/tv_lucky_number_display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textSize="40sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:text="?" />

    </FrameLayout>

    <com.bengharbios.ggames.view.CustomTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="#80FFFFFF"
        android:layout_marginTop="6dp"
        android:text="الرقم الفائز" />

    <com.bengharbios.ggames.view.CustomTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="#FFFFFF"
        android:layout_marginTop="12dp"
        android:text="اختر رقمك (1-10)" />

    <!-- أزرار الأرقام -->
    <androidx.gridlayout.widget.GridLayout xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:columnCount="5"
        app:rowCount="2">

        <com.bengharbios.ggames.view.CustomTextView
            android:id="@+id/btn_lucky_1"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/dialog_action_bg"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:text="1" />

        <com.bengharbios.ggames.view.CustomTextView
            android:id="@+id/btn_lucky_2"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/dialog_action_bg"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:text="2" />

        <com.bengharbios.ggames.view.CustomTextView
            android:id="@+id/btn_lucky_3"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/dialog_action_bg"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:text="3" />

        <com.bengharbios.ggames.view.CustomTextView
            android:id="@+id/btn_lucky_4"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/dialog_action_bg"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:text="4" />

        <com.bengharbios.ggames.view.CustomTextView
            android:id="@+id/btn_lucky_5"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/dialog_action_bg"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:text="5" />

        <com.bengharbios.ggames.view.CustomTextView
            android:id="@+id/btn_lucky_6"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/dialog_action_bg"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:text="6" />

        <com.bengharbios.ggames.view.CustomTextView
            android:id="@+id/btn_lucky_7"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/dialog_action_bg"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:text="7" />

        <com.bengharbios.ggames.view.CustomTextView
            android:id="@+id/btn_lucky_8"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/dialog_action_bg"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:text="8" />

        <com.bengharbios.ggames.view.CustomTextView
            android:id="@+id/btn_lucky_9"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/dialog_action_bg"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:text="9" />

        <com.bengharbios.ggames.view.CustomTextView
            android:id="@+id/btn_lucky_10"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/dialog_action_bg"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:text="10" />

    </androidx.gridlayout.widget.GridLayout>

    <com.bengharbios.ggames.view.CustomTextView
        android:id="@+id/tv_lucky_result"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textSize="14sp"
        android:textColor="#4ADE80"
        android:visibility="invisible"
        android:textStyle="bold"
        android:text="🎉 فزت! +50 💎" />

    <com.bengharbios.ggames.view.CustomTextView
        android:id="@+id/btn_lucky_spin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:padding="12dp"
        android:background="@drawable/dialog_action_confirm"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center"
        android:text="🎲 ابدأ السحب" />

</LinearLayout>
