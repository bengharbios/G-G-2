<?xml version="1.0" encoding="utf-8"?>
<!--
  room_layout_room.xml — الغرفة الرئيسية (مطابق لـ Yalla Ludo v1.5.1.0)
  
  البنية:
  - FrameLayout (الجذر)
    - ImageView (خلفية الغرفة)
    - LinearLayout (محتوى عمودي)
      - LinearLayout (هيدر علوي: مالك + أزرار)
      - room_include_room_body (مقاعد + أريكة + دردشة + شريط جانبي)
      - ConstraintLayout
        - room_include_room_input (شريط إدخال سفلي)
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/roomRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D8A7A">

    <!-- خلفية الغرفة (تدرج لوني) -->
    <ImageView
        android:id="@+id/iv_room_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/room_bg_default" />

    <!-- المحتوى الرئيسي -->
    <LinearLayout
        android:id="@+id/ll_room_content"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- الهيدر العلوي -->
        <include layout="@layout/room_include_room_top" />

        <!-- منطقة الجسم: مقاعد + أريكة + دردشة + شريط جانبي -->
        <include layout="@layout/room_include_room_body" />

        <!-- الشريط السفلي (إدخال + مايك + هدية) -->
        <include layout="@layout/room_include_room_input" />

    </LinearLayout>

</FrameLayout>
