<?xml version="1.0" encoding="utf-8"?>
<!--
  room_include_room_input.xml — الشريط السفلي (مطابق لـ Yalla Ludo v1.5.1.0)
  
  منطق Yalla Ludo الأصلي:
  - visibility=visible  (room_ic_input_sound)  - يظهر دائماً عند عدم الجلوس
  - visibility=gone     (room_ic_input_mic)     - يظهر فقط عند الجلوس على المايك
  - visibility=gone     (room_ic_input_mic_emoji) - يظهر فقط عند الجلوس
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/ll_room_input"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="50dp"
    android:background="#B3000000">

    <!-- أيقونة موجات الصوت (تظهر فقط عند عدم الجلوس) -->
    <ImageView
        android:id="@+id/iv_input_sound"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:src="@drawable/room_ic_input_sound"
        android:layout_marginStart="8dp" />

    <!-- أيقونة المايك (تظهر فقط عند الجلوس على المايك) -->
    <ImageView
        android:id="@+id/iv_input_mic"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:src="@drawable/room_ic_input_mic"
        android:layout_marginStart="8dp" />

    <!-- مايك إيموجي (يظهر فقط عند الجلوس) -->
    <ImageView
        android:id="@+id/iv_input_mic_emoji"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:src="@drawable/room_mic_emoji_icon"
        android:layout_marginStart="8dp" />

    <!-- حقل النص -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">

        <com.bengharbios.ggames.view.FixedEmojiEditText
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:textColorHint="#8FFFFFFF"
            android:gravity="center_vertical|start"
            android:id="@+id/et_message"
            android:background="@drawable/room_input_bg"
            android:padding="8dp"
            android:focusableInTouchMode="true"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:maxHeight="93dp"
            android:minHeight="50dp"
            android:hint="@string/room_say_something"
            android:includeFontPadding="false"
            android:drawablePadding="4dp"
            android:layout_weight="1"
            android:inputType="textMultiLine|textAutoCorrect"
            android:layout_marginStart="11dp"
            android:layout_marginEnd="5dp" />
    </LinearLayout>

    <!-- زر الإيموجي (تبديل) -->
    <com.bengharbios.ggames.view.CheckedImageView
        android:id="@+id/iv_input_emoji"
        android:visibility="gone"
        android:layout_width="37dp"
        android:layout_height="50dp"
        android:src="@drawable/room_mic_emoji_icon"
        android:paddingEnd="13dp" />

    <!-- زر الهدية -->
    <ImageView
        android:id="@+id/iv_input_gift"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:src="@drawable/room_gift_default"
        android:paddingEnd="13dp" />

    <!-- زر ألعاب/مزيد -->
    <ImageView
        android:id="@+id/iv_input_more"
        android:visibility="gone"
        android:layout_width="37dp"
        android:layout_height="50dp"
        android:src="@drawable/room_icon_room_top_more"
        android:paddingEnd="13dp" />

    <!-- زر الهدية المتحركة (SVGA) -->
    <com.bengharbios.ggames.view.LudoSVGAView
        android:id="@+id/svga_input_gift"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_marginBottom="3dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:play_on_attach="true" />

</LinearLayout>
