<?xml version="1.0" encoding="utf-8"?>
<!--
  room_include_room_top.xml — الهيدر العلوي (مطابق لـ Yalla Ludo v1.5.1.0)
  البنية:
  - LinearLayout أفقي
    - ConstraintLayout (بطاقة المالك)
      - RoundImageView (صورة المالك - 40dp)
      - MarqueeTextView (اسم الغرفة - 13sp)
      - LinearLayout (مستوى + VIP)
    - Space (مرن)
    - ImageView (follow - 40dp)
    - ImageView (share - 40dp)
    - ImageView (close - 40dp)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="2dp"
    android:focusable="false"
    android:layout_width="match_parent"
    android:layout_height="50dp"
    android:layout_marginTop="8dp">

    <!-- بطاقة المالك -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/room_top_owner_bg"
        android:focusable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:paddingEnd="10dp">

        <!-- صورة المالك (40dp دائري) -->
        <com.bengharbios.ggames.view.RoundImageView
            android:id="@+id/riv_room_top_header"
            android:layout_gravity="center"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/room_default"
            android:scaleType="centerCrop"
            app:cornerRadius="5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- تاج المالك فوق الصورة -->
        <com.bengharbios.ggames.view.RoundImageView
            android:id="@+id/iv_room_owner_badge"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/room_icon_room_top_close_king"
            android:scaleType="centerInside"
            app:isCircle="true"
            app:layout_constraintBottom_toBottomOf="@id/riv_room_top_header"
            app:layout_constraintEnd_toEndOf="@id/riv_room_top_header"
            app:layout_constraintStart_toStartOf="@id/riv_room_top_header"
            app:layout_constraintTop_toTopOf="@id/riv_room_top_header" />

        <!-- اسم الغرفة (Marquee) -->
        <com.bengharbios.ggames.view.MarqueeTextView
            android:id="@+id/tv_room_top_name"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:ellipsize="marquee"
            android:gravity="center_vertical"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:maxWidth="92dp"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:marqueeRepeatLimit="-1"
            android:layout_marginStart="4dp"
            app:layout_constraintStart_toEndOf="@id/riv_room_top_header"
            app:layout_constraintTop_toTopOf="@id/riv_room_top_header" />

        <!-- مستوى المالك -->
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_room_owner_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            app:layout_constraintStart_toEndOf="@id/riv_room_top_header"
            app:layout_constraintBottom_toBottomOf="@id/riv_room_top_header">

            <com.bengharbios.ggames.view.CustomTextView
                android:id="@+id/tv_room_top_level"
                android:textSize="12dp"
                android:textColor="#FFFFFF"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="Lv.1" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- مساحة مرنة -->
    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- زر المتابعة -->
    <ImageView
        android:id="@+id/iv_room_top_follow"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/icon_room_top_follow"
        android:scaleType="centerInside" />

    <!-- زر المشاركة -->
    <ImageView
        android:id="@+id/iv_room_top_share"
        android:visibility="visible"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/room_icon_room_top_more"
        android:scaleType="centerInside" />

    <!-- زر الإغلاق -->
    <ImageView
        android:id="@+id/iv_room_top_close"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/room_icon_room_top_close"
        android:scaleType="centerInside" />

</LinearLayout>
